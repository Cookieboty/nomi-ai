{
  "name": "@nomi-ai/bundle-ig-base",
  "version": "0.0.1",
  "private": true,
  "description": "插件包：跨环境通用 AI 能力（LLM Providers / 内置工具 / 护栏 / MCP 桥接 / 4 层记忆含用户偏好薄层）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/run-bin.mjs tsup",
    "dev": "node ../../scripts/run-bin.mjs tsup --watch",
    "typecheck": "node ../../scripts/run-bin.mjs tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node ../../scripts/run-bin.mjs vitest run",
    "clean": "node ../../scripts/run-bin.mjs rimraf dist coverage .turbo"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
