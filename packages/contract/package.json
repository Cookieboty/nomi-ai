{
  "name": "@nomi-ai/contract",
  "version": "0.0.1",
  "private": true,
  "description": "视图与内核之间的 API 契约：defineContract / createClient / implement、可序列化线协议与传输接口（不依赖 Electron）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/run-bin.mjs tsup",
    "dev": "node ../../scripts/run-bin.mjs tsup --watch",
    "typecheck": "node ../../scripts/run-bin.mjs tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint . --max-warnings=0",
    "test": "node ../../scripts/run-bin.mjs vitest run",
    "clean": "node ../../scripts/run-bin.mjs rimraf dist coverage .turbo"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  }
}
