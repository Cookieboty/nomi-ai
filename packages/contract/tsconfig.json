{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // 视图（浏览器）与内核（Node）都会加载：只用两边都有的全局（AbortController、structuredClone…），
    // 不引 Node 类型，防止误用 node 内置模块
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.spec.ts", "tests/**/*"]
}
