{
  "name": "@nomi-ai/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Nomi 共享 UI：设计 token（CSS 变量）+ 轻量 React 组件",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/run-bin.mjs tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "clean": "node ../../scripts/run-bin.mjs rimraf dist",
    "typecheck": "node ../../scripts/run-bin.mjs tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-bin.mjs vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^1.55.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
