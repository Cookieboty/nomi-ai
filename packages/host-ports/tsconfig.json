{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    // 端口是平台无关的契约：不引入 node 全局类型，防止误用 Buffer / NodeJS.* 等宿主类型
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.spec.ts", "tests/**/*"]
}
