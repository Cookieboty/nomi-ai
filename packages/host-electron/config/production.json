{
  "logging": {
    "level": "info",
    "enablePerformanceLogging": false,
    "enableColors": false,
    "logFormat": "json",
    "maxLogFiles": 10,
    "rotateOnStart": true
  },
  "security": {
    "enableSecurityWarnings": true,
    "allowUnsafeContent": false,
    "enableRemoteDebugging": false
  },
  "performance": {
    "enableHardwareAcceleration": true,
    "startupOptimization": true,
    "memoryLimit": 256
  },
  "mcp": {
    "enabled": true,
    "autoStart": true,
    "timeout": 15000,
    "retryAttempts": 2
  },
  "cache": {
    "maxSize": 1000,
    "defaultTtl": 1800000,
    "cleanupInterval": 300000,
    "enableCompression": true
  },
  "window": {
    "main": {
      "alwaysOnTop": true,
      "skipTaskbar": true
    },
    "aiChat": {
      "webPreferences": {
        "devTools": false,
        "webSecurity": true
      }
    }
  },
  "updates": {
    "enabled": true,
    "checkInterval": 86400000,
    "autoDownload": false,
    "allowPrerelease": false
  },
  "telemetry": {
    "enabled": false,
    "anonymizeData": true,
    "reportCrashes": true
  },
  "optimization": {
    "enableBundleAnalyzer": false,
    "enableTreeShaking": true,
    "enableMinification": true,
    "enableGzip": true
  }
}
