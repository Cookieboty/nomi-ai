{
  "logging": {
    "level": "error",
    "enableFileOutput": false,
    "enableConsoleOutput": false,
    "logFormat": "simple"
  },
  "security": {
    "enableSecurityWarnings": false,
    "allowUnsafeContent": true,
    "enableRemoteDebugging": false
  },
  "performance": {
    "enableHardwareAcceleration": false,
    "startupOptimization": false,
    "memoryLimit": 128
  },
  "mcp": {
    "enabled": false,
    "autoStart": false
  },
  "cache": {
    "maxSize": 10,
    "defaultTtl": 1000,
    "cleanupInterval": 100
  },
  "window": {
    "main": {
      "show": false,
      "alwaysOnTop": false,
      "skipTaskbar": true
    },
    "aiChat": {
      "show": false,
      "webPreferences": {
        "devTools": false,
        "webSecurity": false
      }
    }
  },
  "voice": {
    "enabled": false
  },
  "testing": {
    "mockElectron": true,
    "mockFileSystem": true,
    "mockNetwork": true,
    "fastMode": true,
    "timeout": 5000
  }
}
