{
  "app": {
    "name": "Nomi·诺米",
    "version": "1.0.0",
    "autoStart": true,
    "checkForUpdates": true
  },
  "window": {
    "main": {
      "width": 420,
      "height": 450,
      "frame": false,
      "transparent": true,
      "resizable": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "backgroundColor": "#00000000"
    },
    "aiChat": {
      "width": 1000,
      "height": 800,
      "frame": true,
      "transparent": false,
      "resizable": true,
      "center": true,
      "autoHideMenuBar": true
    },
    "defaultPosition": {
      "x": 0,
      "y": 0
    }
  },
  "voice": {
    "enabled": true,
    "volume": 0.8,
    "timeAnnouncement": true,
    "voicePackPath": "packages/renderer/public/assets/voice",
    "voiceMode": "fixed",
    "languages": ["zh-CN", "en-US"],
    "defaultLanguage": "zh-CN"
  },
  "cache": {
    "maxSize": 500,
    "defaultTtl": 600000,
    "cleanupInterval": 60000,
    "enableCompression": false
  },
  "logging": {
    "level": "info",
    "enableFileOutput": true,
    "enableConsoleOutput": true,
    "maxLogSize": 10485760,
    "maxLogFiles": 5,
    "logFormat": "detailed",
    "enableColors": true,
    "enableTimestamps": true,
    "enableContext": true,
    "enablePerformanceLogging": false,
    "rotateOnStart": false
  },
  "security": {
    "enableSecurityWarnings": true,
    "allowUnsafeContent": false,
    "enableRemoteDebugging": false
  },
  "performance": {
    "enableHardwareAcceleration": true,
    "memoryLimit": 512,
    "enableLazyLoading": true,
    "startupOptimization": true
  },
  "mcp": {
    "enabled": true,
    "autoStart": true,
    "port": 7213,
    "timeout": 30000,
    "retryAttempts": 3,
    "tools": {
      "conversation_complete": true,
      "project_summary_voice": true,
      "reset_call_counter": true,
      "check_call_status": true
    }
  },
  "ai": {
    "defaultProvider": "deepseek",
    "models": [
      {
        "id": "deepseek",
        "name": "DeepSeek Chat",
        "provider": "deepseek",
        "apiUrl": "https://api.deepseek.com",
        "model": "deepseek-chat",
        "enabled": false,
        "temperature": 0.7,
        "maxTokens": 2048
      }
    ],
    "settings": {
      "theme": "light",
      "language": "zh-CN",
      "fontSize": 14,
      "autoSave": true,
      "maxHistoryLength": 1000
    }
  }
}
