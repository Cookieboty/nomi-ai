{
  "name": "@nomi-ai/electron",
  "version": "1.0.2",
  "description": "Electron主进程和预加载脚本",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run clean",
    "build": "node ../../scripts/run-bin.mjs tsc && node scripts/bundle-preload.mjs",
    "copy-renderer": "node scripts/copy-renderer.js",
    "clean": "node ../../scripts/run-bin.mjs rimraf dist",
    "package": "npm run package:prod",
    "package:prod": "electron-builder build --publish never",
    "package:prod:mac": "electron-builder build --mac --publish never",
    "package:prod:win": "electron-builder build --win --publish never",
    "package:prod:linux": "electron-builder build --linux --publish never",
    "package:debug": "cross-env DEBUG=true electron-builder build --config.asar=false -c.extraMetadata.debug=true",
    "launch:debug": "npm run copy-renderer && electron .",
    "test": "jest --watchman=false",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "package:publish:mac": "electron-builder build --mac --publish always",
    "package:publish:win": "electron-builder build --win --publish always",
    "package:publish:linux": "electron-builder build --linux --publish always",
    "postinstall": "node scripts/ensure-tts-model.mjs --postinstall",
    "ensure-tts-model": "node scripts/ensure-tts-model.mjs",
    "sync-tts-model": "node scripts/sync-tts-model.mjs",
    "prepackage": "node scripts/sync-tts-model.mjs",
    "prepackage:prod": "node scripts/sync-tts-model.mjs",
    "prepackage:prod:mac": "node scripts/sync-tts-model.mjs",
    "prepackage:prod:win": "node scripts/sync-tts-model.mjs",
    "prepackage:prod:linux": "node scripts/sync-tts-model.mjs",
    "prepackage:debug": "node scripts/sync-tts-model.mjs",
    "prepackage:publish:mac": "node scripts/sync-tts-model.mjs",
    "prepackage:publish:win": "node scripts/sync-tts-model.mjs",
    "prepackage:publish:linux": "node scripts/sync-tts-model.mjs"
  },
  "author": "Cookieboty",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/mcp": "^2.0.73",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@nomi-ai/ai-runtime": "workspace:*",
    "@nomi-ai/ai-sdk": "workspace:*",
    "@nomi-ai/ai-sdk-client": "workspace:*",
    "@nomi-ai/bundle-ig-base": "workspace:*",
    "@nomi-ai/bundle-ig-electron-caps": "workspace:*",
    "@nomi-ai/bundle-ig-mascot": "workspace:*",
    "@nomi-ai/types": "workspace:*",
    "ai": "^7.0.136",
    "electron-updater": "^6.6.2",
    "fflate": "^0.8.3",
    "onnxruntime-web": "1.30.0",
    "sherpa-onnx-node": "1.13.8",
    "tar-stream": "3.2.2",
    "tesseract.js": "7.0.0",
    "unbzip2-stream": "1.4.3",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/tar-stream": "3.1.5",
    "cross-env": "^10.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.17.0",
    "fs-extra": "^11.4.1",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "desktopName": "nomi.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cookieboty/nomi-ai.git"
  },
  "homepage": "https://github.com/Cookieboty/nomi-ai"
}
