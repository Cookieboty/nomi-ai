{
  "name": "@nomi-ai/character-contract",
  "version": "0.0.1",
  "private": true,
  "description": "角色包契约：manifest / persona / mapping / locales 的类型与 zod schema、contract.json、voice-ids.json、validatePack 与迁移函数（Node 与浏览器通用，不依赖 Electron）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./contract.json": "./contract.json",
    "./voice-ids.json": "./voice-ids.json"
  },
  "files": [
    "dist",
    "contract.json",
    "voice-ids.json",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/run-bin.mjs tsup",
    "dev": "node ../../scripts/run-bin.mjs tsup --watch",
    "typecheck": "node ../../scripts/run-bin.mjs tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node ../../scripts/run-bin.mjs vitest run",
    "clean": "node ../../scripts/run-bin.mjs rimraf dist coverage .turbo"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
