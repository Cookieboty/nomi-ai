* text=auto eol=lf

*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.mp3   binary
*.wav   binary
*.mtn   binary
*.moc   binary
*.vrm   binary

# husky hooks 保留可执行
.husky/*  text eol=lf

# Git LFS — large Rive / mascot source assets (no history rewrite)
*.riv filter=lfs diff=lfs merge=lfs -text
*.rml filter=lfs diff=lfs merge=lfs -text
rive/**/*.png filter=lfs diff=lfs merge=lfs -text
rive/**/*.svg filter=lfs diff=lfs merge=lfs -text
