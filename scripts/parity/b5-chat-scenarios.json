    {"name": "regenerate", "providers": [{"id": "p1", "stream": [{"type": "delta", "content": "again"}, {"type": "done", "finishReason": "length"}]}],
     "calls": [{"op": "regenerate", "opts": {"reqId": "r1", "messages": [{"role": "user", "content": "hi"}]}}]},
    {"name": "stream-no-reqid", "providers": [{"id": "p1", "stream": [{"type": "delta", "content": "x"}]}],
     "calls": [{"op": "stream", "opts": {"messages": [{"role": "user", "content": "hi"}]}}]},
    {"name": "agent-tools", "providers": [{"id": "p1", "withTools": true, "stream": [{"type": "delta", "content": "tool answer"}, {"type": "done", "finishReason": "tool_calls"}]}], "tools": ["t.a", "t.b"], "resolve": {"agent-tools": {"id": "p1", "model": "am"}},
     "calls": [{"op": "agent", "opts": {"reqId": "r1", "messages": [{"role": "user", "content": "do"}]}}, {"op": "agentStream", "opts": {"reqId": "r2", "messages": [{"role": "user", "content": "do"}]}}]},
    {"name": "agent-no-tools", "providers": [{"id": "p1", "withTools": true, "stream": [{"type": "delta", "content": "plain"}]}],
     "calls": [{"op": "agent", "opts": {"reqId": "r1", "messages": [{"role": "user", "content": "do"}]}}, {"op": "agentStream", "opts": {"reqId": "r2", "messages": [{"role": "user", "content": "do"}]}}]},
    {"name": "agent-tools-unsupported", "providers": [{"id": "p1", "stream": [{"type": "delta", "content": "plain"}]}], "tools": ["t.a"],
     "calls": [{"op": "agentStream", "opts": {"reqId": "r1", "messages": [{"role": "user", "content": "do"}]}}]},
    {"name": "abort", "providers": [{"id": "p1"}, {"id": "p2"}],
     "calls": [{"op": "abort", "reqId": "rx"}]}
  ]
}
