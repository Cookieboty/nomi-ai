    {"name": "no-registry", "noRegistry": true, "calls": [{"op": "stream", "opts": {"reqId": "r1", "messages": []}}, {"op": "abort", "reqId": "r1"}]},
    {"name": "first-provider", "providers": [{"id": "p1"}, {"id": "p2"}],
