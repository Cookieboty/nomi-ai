    {"name": "stream-emit", "providers": [{"id": "p1", "stream": [{"type": "delta", "content": "Hel"}, {"type": "reasoning", "content": "think"}, {"type": "delta", "content": "lo"}, {"type": "done", "finishReason": "stop"}]}], "resolve": {"chat": {"id": "p1", "model": "m1"}},
     "calls": [{"op": "stream", "opts": {"reqId": "r1", "messages": [{"role": "user", "content": "hi"}], "context": {"maxMessages": 1}}}]},
    {"name": "stream-blank", "providers": [{"id": "p1", "stream": [{"type": "delta", "content": "  \n"}, {"type": "done", "finishReason": "stop"}]}],
