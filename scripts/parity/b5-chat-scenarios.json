{
  "tokens": ["", "a", "hello world", "你好，世界", "mixed 中文 text ok", "😀😀 emoji", "ｶﾀｶﾅ and 한국어", "   ", "x\ny\tz"],
  "fit": [
    {"name": "empty", "messages": []},
    {"name": "system-only", "messages": [{"role": "system", "content": "sys"}]},
    {"name": "basic", "messages": [{"role": "system", "content": "be nice"}, {"role": "user", "content": "hi"}, {"role": "assistant", "content": "hello"}, {"role": "user", "content": "how are you"}]},
    {"name": "max-messages", "budget": {"maxMessages": 2}, "messages": [{"role": "user", "content": "a"}, {"role": "assistant", "content": "b"}, {"role": "user", "content": "c"}, {"role": "assistant", "content": "d"}, {"role": "user", "content": "e"}]},
    {"name": "max-messages-0", "budget": {"maxMessages": 0}, "messages": [{"role": "user", "content": "a"}, {"role": "user", "content": "b"}]},
    {"name": "tokens-drop-old", "budget": {"maxTokens": 20}, "messages": [{"role": "user", "content": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}, {"role": "assistant", "content": "bbbb"}, {"role": "user", "content": "cccc"}]},
    {"name": "truncate-last", "budget": {"maxTokens": 10}, "messages": [{"role": "system", "content": "s"}, {"role": "user", "content": "the quick brown fox jumps over the lazy dog many many times over"}]},
    {"name": "truncate-cjk", "budget": {"maxTokens": 9}, "messages": [{"role": "user", "content": "一二三四五六七八九十一二三四五六七八九十"}]},
    {"name": "truncate-negative", "budget": {"maxTokens": 2}, "messages": [{"role": "system", "content": "long system prompt here"}, {"role": "user", "content": "hello there"}]},
    {"name": "orphan-assistant", "budget": {"maxMessages": 3}, "messages": [{"role": "user", "content": "u1"}, {"role": "assistant", "content": "a1"}, {"role": "tool", "content": "t1"}, {"role": "assistant", "content": "a2"}, {"role": "user", "content": "u2"}]},
    {"name": "last-assistant", "messages": [{"role": "assistant", "content": "only"}]},
    {"name": "interleaved-system", "messages": [{"role": "user", "content": "u1"}, {"role": "system", "content": "s1"}, {"role": "user", "content": "u2"}]}
  ],
  "facade": [
    {"name": "send-resolve", "providers": [{"id": "p1"}, {"id": "p2"}], "resolve": {"chat": {"id": "p2", "model": "m-routed"}},
