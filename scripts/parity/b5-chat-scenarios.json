    {"name": "send-explicit", "providers": [{"id": "p1"}, {"id": "p2"}], "resolve": {"chat": {"id": "p2"}},
     "calls": [{"op": "sendMessage", "opts": {"reqId": "r1", "provider": "p1", "model": "mx", "messages": [{"role": "user", "content": "hi"}], "maxTokens": 9, "topP": 0.2, "extra": {"k": 1}}}]},
    {"name": "send-missing", "providers": [{"id": "p1"}],
     "calls": [{"op": "sendMessage", "opts": {"reqId": "r1", "provider": "nope", "messages": []}}]},
    {"name": "send-empty-registry", "providers": [],
