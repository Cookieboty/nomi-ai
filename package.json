{
  "name": "nomi",
  "version": "2.0.5",
  "description": "Nomi·诺米：本地运行的桌面 AI 伙伴（Electron + IgPluginHost / Vercel AI SDK）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/doctor.mjs --quick && node scripts/run-bin.mjs turbo run dev --filter=@nomi-ai/core --filter=@nomi-ai/host-electron --filter=@nomi-ai/renderer --filter=@nomi-ai/ai-chat --ui=stream --log-order=stream",
    "dev:libs": "node scripts/run-bin.mjs turbo run dev --filter=./packages/* --filter=!@nomi-ai/core --filter=!@nomi-ai/host-electron --filter=!@nomi-ai/renderer --filter=!@nomi-ai/ai-chat --concurrency=20",
    "dev:web": "node scripts/dev-web/start.mjs",
    "build": "node scripts/run-bin.mjs turbo run build",
    "build:renderer": "node scripts/run-bin.mjs turbo run build --filter=@nomi-ai/renderer",
    "build:electron": "node scripts/run-bin.mjs turbo run build --filter=@nomi-ai/host-electron",
    "package": "node scripts/run-bin.mjs turbo run package",
    "package:prod:mac": "node scripts/run-bin.mjs turbo run package:prod:mac",
    "package:prod:win": "node scripts/run-bin.mjs turbo run package:prod:win",
    "package:prod:linux": "node scripts/run-bin.mjs turbo run package:prod:linux",
    "package:debug": "node scripts/run-bin.mjs turbo run package:debug",
    "test": "node scripts/run-bin.mjs turbo run test && pnpm run test:root",
    "test:root": "vitest run --config vitest.root.config.ts scripts/__tests__",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e-cli": "vitest run --config vitest.e2e-cli.config.ts",
    "test:e2e:headed": "playwright test --config playwright.config.ts",
    "smoke:web": "node scripts/dev-web/smoke.mjs",
    "lint": "node scripts/run-bin.mjs turbo run lint",
    "typecheck": "node scripts/run-bin.mjs turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/run-bin.mjs turbo run clean",
    "doctor": "node scripts/doctor.mjs",
    "dev:smoke": "node scripts/dev-smoke.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:version": "node scripts/release/changelog.mjs --release && changeset version",
    "preinstall": "node scripts/check-node.cjs",
    "prepare": "husky",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:i18n": "node scripts/i18n/check.cjs",
    "check:character-leak": "node scripts/check-character-leak.mjs",
    "check:frontend": "node scripts/check-frontend-standards.mjs",
    "changelog": "node scripts/release/changelog.mjs",
    "changelog:check": "node scripts/release/changelog.mjs --check",
    "character:check": "node scripts/character/check.mjs",
    "character:apply": "node scripts/character/apply.mjs",
    "character:init": "node scripts/character/init.mjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@nomi-ai/ai-runtime": "workspace:*",
    "@nomi-ai/ai-sdk": "workspace:*",
    "@nomi-ai/ai-sdk-client": "workspace:*",
    "@nomi-ai/bundle-ig-base": "workspace:*",
    "@nomi-ai/bundle-ig-electron-caps": "workspace:*",
    "@nomi-ai/bundle-ig-mascot": "workspace:*",
    "@nomi-ai/contract": "workspace:*",
    "@nomi-ai/core": "workspace:*",
    "@nomi-ai/host-node": "workspace:*",
    "@nomi-ai/host-ports": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "husky": "^9.1.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cookieboty/nomi-ai.git"
  },
  "pnpm": {
    "overrides": {
      "undici": "7.30.1",
      "zod": "^4.6.6",
      "electron": "44.9.3"
    }
  }
}
