{
  "logging": {
    "level": "debug",
    "enablePerformanceLogging": true,
    "enableColors": true,
    "logFormat": "detailed"
  },
  "security": {
    "enableRemoteDebugging": true,
    "allowUnsafeContent": true
  },
  "performance": {
    "enableHardwareAcceleration": true,
    "startupOptimization": false
  },
  "mcp": {
    "enabled": true,
    "autoStart": true,
    "timeout": 60000,
    "debug": true
  },
  "cache": {
    "maxSize": 100,
    "defaultTtl": 60000,
    "cleanupInterval": 10000
  },
  "window": {
    "main": {
      "alwaysOnTop": false
    },
    "aiChat": {
      "webPreferences": {
        "devTools": true,
        "webSecurity": false
      }
    }
  },
  "hotReload": {
    "enabled": true,
    "watchPaths": ["src/**/*", "config/**/*"]
  },
  "debug": {
    "showPerformanceMetrics": true,
    "enableMemoryMonitoring": true,
    "logIpcCalls": true,
    "enableEventTracing": true
  }
}
