{
  "name": "@nomi-ai/host-ports",
  "version": "0.0.1",
  "private": true,
  "description": "宿主端口定义：内核经这些接口使用路径、安全存储、文件对话框、剪贴板、截屏、电源、生命周期与窗口（纯类型，不依赖 Electron）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../../scripts/run-bin.mjs tsup",
    "dev": "node ../../../../scripts/run-bin.mjs tsup --watch",
    "typecheck": "node ../../../../scripts/run-bin.mjs tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "clean": "node ../../../../scripts/run-bin.mjs rimraf dist coverage .turbo"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3"
  }
}
