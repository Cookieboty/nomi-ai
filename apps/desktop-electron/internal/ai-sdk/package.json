{
  "name": "@nomi-ai/ai-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "AI SDK 门面（环境无关）：AIClient + 7 Facade + DTO + zod 校验",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../../scripts/run-bin.mjs tsup",
    "dev": "node ../../../../scripts/run-bin.mjs tsup --watch",
    "typecheck": "node ../../../../scripts/run-bin.mjs tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node ../../../../scripts/run-bin.mjs vitest run",
    "clean": "node ../../../../scripts/run-bin.mjs rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "@nomi-ai/bundle-ig-base": "workspace:*",
    "@nomi-ai/bundle-ig-mascot": "workspace:*",
    "@nomi-ai/bundle-ig-electron-caps": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nomi-ai/bundle-ig-mascot": {
      "optional": true
    },
    "@nomi-ai/bundle-ig-electron-caps": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nomi-ai/bundle-ig-base": "workspace:*",
    "@nomi-ai/bundle-ig-electron-caps": "workspace:*",
    "@nomi-ai/bundle-ig-mascot": "workspace:*",
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
