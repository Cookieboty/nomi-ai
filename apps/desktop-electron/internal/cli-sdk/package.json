{
  "name": "@nomi-ai/cli-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "编程助手插件契约与共享会话驱动（acp / stream-json / app-server / exec）；纯 Node，不依赖 Electron",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../../scripts/run-bin.mjs tsup",
    "dev": "node ../../../../scripts/run-bin.mjs tsup --watch",
    "typecheck": "node ../../../../scripts/run-bin.mjs tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node ../../../../scripts/run-bin.mjs vitest run",
    "clean": "node ../../../../scripts/run-bin.mjs rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@nomi-ai/cli-catalog": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  }
}
