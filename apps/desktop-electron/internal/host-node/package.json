{
  "name": "@nomi-ai/host-node",
  "version": "0.0.1",
  "private": true,
  "description": "无界面宿主：用临时目录、内存密钥、预设对话框答案实现宿主端口，建无界面内核（e2e 与开发），以及开发态的契约 WebSocket 传输（纯 Node，不依赖 Electron）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js",
      "require": "./dist/websocket.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../../scripts/run-bin.mjs tsup",
    "dev": "node ../../../../scripts/run-bin.mjs tsup --watch",
    "typecheck": "node ../../../../scripts/run-bin.mjs tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node ../../../../scripts/run-bin.mjs vitest run",
    "clean": "node ../../../../scripts/run-bin.mjs rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@nomi-ai/contract": "workspace:*",
    "@nomi-ai/core": "workspace:*",
    "@nomi-ai/host-ports": "workspace:*",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.6"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "websocket": [
        "./dist/websocket.d.ts"
      ]
    }
  }
}
