{
  "name": "@nomi-ai/ai-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "AI 运行时（纯 Node）：IgPluginHost + Vercel AI SDK Booter + AIClient + 契约处理函数",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../../scripts/run-bin.mjs tsup",
    "dev": "node ../../../../scripts/run-bin.mjs tsup --watch",
    "typecheck": "node ../../../../scripts/run-bin.mjs tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node ../../../../scripts/run-bin.mjs vitest run",
    "clean": "node ../../../../scripts/run-bin.mjs rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "@nomi-ai/ai-sdk": "workspace:*",
    "@nomi-ai/bundle-ig-base": "workspace:*"
  },
  "devDependencies": {
    "@nomi-ai/ai-sdk": "workspace:*",
    "@nomi-ai/bundle-ig-base": "workspace:*",
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/mcp": "^2.0.73",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@nomi-ai/contract": "workspace:*",
    "ai": "^7.0.136",
    "zod": "^4.6.6"
  }
}
