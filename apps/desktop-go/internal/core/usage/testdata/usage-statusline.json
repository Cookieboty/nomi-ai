 "scripts": [
  {
   "root": "/u/data/usage",
   "out": "#!/bin/sh\n# nomi-usage-statusline: saves Claude Code's statusline JSON next to Nomi's usage data (local only, 0600),\n# then runs your previous statusLine command, if any. Undo it in Nomi: Settings > Usage & cost.\nSNAP='/u/data/usage/claude-statusline.json'\nORIGCMD='/u/data/usage/claude-statusline.orig.cmd'\numask 077\ntmp=\"$SNAP.$$\"\ncat > \"$tmp\" && mv \"$tmp\" \"$SNAP\" || exit 0\nif [ -s \"$ORIGCMD\" ]; then\n  sh -c \"$(cat \"$ORIGCMD\")\" < \"$SNAP\"\nfi\nexit 0\n"
  },
  {
