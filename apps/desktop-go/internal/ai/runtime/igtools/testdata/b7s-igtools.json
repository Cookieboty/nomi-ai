  "delegate_to_cli": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "goal": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000,
     "description": "要做成什么，写具体"
    },
    "done_when": {
     "type": "string",
     "minLength": 1,
     "maxLength": 2000,
     "description": "完成标准：怎样算做完（如「npm test 通过」）"
    },
    "context": {
     "description": "已知背景：相关文件、报错、用户原话",
     "type": "string",
     "maxLength": 8000
    },
    "out_of_scope": {
     "description": "不要碰的范围",
     "type": "string",
     "maxLength": 2000
    },
    "kind": {
     "description": "任务类型：coding 编程开发 / prd 需求文档 / review 代码审查 / research 调研分析",
     "type": "string",
     "enum": [
      "coding",
      "prd",
      "review",
      "research"
     ]
    },
    "cli": {
     "description": "只有用户在消息里点名了某个编程助手时才填（claude / codex / grok / gemini / dsh）",
     "type": "string"
    },
    "cwd": {
     "description": "工作目录（必须是用户已授权的文件夹）；缺省用最近的工作目录",
     "type": "string"
    },
    "background": {
     "description": "是否后台执行：默认 true（立刻返回 taskId，Nomi 可继续聊，完成后通知；用 delegate_status 查询）；false 则同步等到这一轮结束",
     "type": "boolean"
    },
    "profile": {
     "description": "委派模型档位 id（如 default / cheap / local，或用户自定义）。缺省用设置里的默认档位；显式 model 优先于档位",
     "type": "string"
    },
    "model": {
     "description": "覆盖子编程助手模型：第三方为「供应商/模型」，官方为 CLI 原生模型名。优先于 profile",
     "type": "string"
    },
    "reasoning_effort": {
     "description": "覆盖思考深度（如 low / medium / high）；缺省用档位或 CLI 默认",
     "type": "string"
    }
   },
   "required": [
    "goal",
    "done_when"
   ],
   "additionalProperties": false
  },
  "delegate_status": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "taskId": {
     "type": "string",
     "minLength": 1,
     "description": "delegate_to_cli 返回的 taskId（编程助手标签 id）"
    }
   },
   "required": [
    "taskId"
   ],
   "additionalProperties": false
  },
  "delegate_followup": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "taskId": {
     "type": "string",
     "minLength": 1,
     "description": "delegate_to_cli 返回的 taskId"
    },
    "message": {
     "type": "string",
     "minLength": 1,
     "maxLength": 8000,
     "description": "在同一个编程助手标签里接着问的内容"
    }
   },
   "required": [
    "taskId",
    "message"
   ],
   "additionalProperties": false
  },
  "skill_load": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64,
     "description": "技能名称"
    }
   },
   "required": [
    "name"
   ],
   "additionalProperties": false
  },
  "skill_read_file": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64
    },
    "path": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200,
     "description": "技能文件夹内的相对路径"
    }
   },
   "required": [
    "name",
    "path"
   ],
   "additionalProperties": false
  }
 },
