     "PATH": "/bin",
     "HOME": "/h",
     "ANTHROPIC_API_KEY": "k",
     "Z": "1"
    },
    "env": {
     "HOME": "/p",
     "NEW": "n",
     "PATH": "/x"
    },
    "strip": [
     "ANTHROPIC_API_KEY",
     "MISSING"
    ]
   },
   {
    "op": "applyLaunchEnv",
    "base": {
     "A": "1"
    },
    "env": {},
    "strip": []
   }
  ],
