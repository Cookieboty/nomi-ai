 "gatewayEntries": [
  {
   "client": "claude",
   "clientSpec": {
    "builtinModels": [
     {
      "pattern": "^(?=.*(?:claude|^(?:opus|sonnet|haiku|fable|default)$)).*opus",
      "slot": "tiers.opus"
     },
     {
      "pattern": "^(?=.*(?:claude|^(?:opus|sonnet|haiku|fable|default)$)).*sonnet",
      "slot": "tiers.sonnet"
     },
     {
      "pattern": "^(?=.*(?:claude|^(?:opus|sonnet|haiku|fable|default)$)).*haiku",
      "slot": "tiers.haiku"
     },
     {
      "pattern": "^(?=.*(?:claude|^(?:opus|sonnet|haiku|fable|default)$)).*fable",
      "slot": "tiers.fable"
     },
     {
      "pattern": "(?:claude|^(?:opus|sonnet|haiku|fable|default)$)",
      "slot": "main"
     }
    ],
    "heartbeat": {
     "kind": "ping"
    },
    "id": "claude",
    "legacy": {
     "ingress": "messages"
    },
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "strictness": "lenient",
    "synthesizedReasoning": [
     "thinking.budget_tokens"
    ],
    "unknownToMain": false
   },
   "ingress": "messages"
  },
  {
   "client": "codex",
   "clientSpec": {
    "heartbeat": {
     "kind": "comment"
    },
    "id": "codex",
    "legacy": {
     "userAgent": "codex"
    },
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "strictness": "lenient",
    "unknownToMain": true
   },
   "ingress": "responses"
  },
  {
   "client": "grok",
   "clientSpec": {
    "acceptedEvents": "spec",
    "builtinModels": [
     {
      "pattern": "^nomi$",
      "slot": "main"
     }
    ],
    "heartbeat": {
     "kind": "comment"
    },
    "helperModels": [
     "^grok-4\\.6"
    ],
    "id": "grok",
    "legacy": {
     "userAgent": "grok"
    },
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "strictness": "strict",
    "unknownToMain": true
   },
   "ingress": "responses"
  },
  {
   "client": "dsh",
   "clientSpec": {
    "heartbeat": {
     "kind": "comment"
    },
    "id": "dsh",
    "legacy": {
     "userAgent": "dsh"
    },
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "strictness": "lenient",
    "unknownToMain": true
   },
   "ingress": "responses"
  },
  {
   "client": "gemini",
   "clientSpec": {
    "heartbeat": {
     "kind": "comment"
    },
    "id": "gemini",
    "legacy": {
     "ingress": "gemini"
    },
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "strictness": "lenient",
    "unknownToMain": true
   },
   "ingress": "gemini"
  }
