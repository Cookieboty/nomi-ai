 "gatewayEntries": [
  {
   "client": "claude",
   "ingress": "messages",
   "clientSpec": {
    "id": "claude",
    "strictness": "lenient",
    "builtinModels": [
     {
      "pattern": "^(?=.*(?:claude|^(?:opus|sonnet|haiku|fable|default)$)).*opus",
      "slot": "tiers.opus"
     },
     {
      "pattern": "^(?=.*(?:claude|^(?:opus|sonnet|haiku|fable|default)$)).*sonnet",
      "slot": "tiers.sonnet"
     },
     {
      "pattern": "^(?=.*(?:claude|^(?:opus|sonnet|haiku|fable|default)$)).*haiku",
      "slot": "tiers.haiku"
     },
     {
      "pattern": "^(?=.*(?:claude|^(?:opus|sonnet|haiku|fable|default)$)).*fable",
      "slot": "tiers.fable"
     },
     {
      "pattern": "(?:claude|^(?:opus|sonnet|haiku|fable|default)$)",
      "slot": "main"
     }
    ],
    "unknownToMain": false,
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "heartbeat": {
     "kind": "ping"
    },
    "legacy": {
     "ingress": "messages"
    },
    "synthesizedReasoning": [
     "thinking.budget_tokens"
    ]
   }
  },
  {
   "client": "codex",
   "ingress": "responses",
   "clientSpec": {
    "id": "codex",
    "strictness": "lenient",
    "unknownToMain": true,
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "heartbeat": {
     "kind": "comment"
    },
    "legacy": {
     "userAgent": "codex"
    }
   }
  },
  {
   "client": "grok",
   "ingress": "responses",
   "clientSpec": {
    "id": "grok",
    "strictness": "strict",
    "acceptedEvents": "spec",
    "helperModels": [
     "^grok-4\\.6"
    ],
    "builtinModels": [
     {
      "pattern": "^nomi$",
      "slot": "main"
     }
    ],
    "unknownToMain": true,
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "heartbeat": {
     "kind": "comment"
    },
    "legacy": {
     "userAgent": "grok"
    }
   }
  },
  {
   "client": "dsh",
   "ingress": "responses",
   "clientSpec": {
    "id": "dsh",
    "strictness": "lenient",
    "unknownToMain": true,
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "heartbeat": {
     "kind": "comment"
    },
    "legacy": {
     "userAgent": "dsh"
    }
   }
  },
  {
   "client": "gemini",
   "ingress": "gemini",
   "clientSpec": {
    "id": "gemini",
    "strictness": "lenient",
    "unknownToMain": true,
    "sessionKey": [
     {
      "bodyPath": "prompt_cache_key",
      "prefix": "pck"
     },
     {
      "header": "x-claude-code-session-id",
      "prefix": "cc"
     },
     {
      "bodyPath": "metadata.user_id",
      "parse": "claude-user",
      "prefix": "cc"
     }
    ],
    "heartbeat": {
     "kind": "comment"
    },
    "legacy": {
     "ingress": "gemini"
    }
   }
  }
 ]
