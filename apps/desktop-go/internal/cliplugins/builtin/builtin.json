       "bypassPermissions"
      ],
      "modeId": "bypassPermissions"
     }
    ],
    "subagents": true,
    "subagentStop": true,
    "slashCommands": true,
    "resume": true,
    "fork": false,
    "usageQuota": true,
    "progressMonitor": true,
    "terminalCommand": true
   },
   "modelSwitch": "inplace",
