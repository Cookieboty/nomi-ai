     "url": "https://docs.claude.com/claude-code"
    }
   },
   "transport": "stream-json",
   "fallbackTransport": "exec",
   "ingress": "messages",
   "capabilities": {
    "officialAccount": true,
    "thirdParty": true,
    "images": "native",
