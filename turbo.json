{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.node.json",
    "tsconfig.dom.json",
    "tsup.base.ts",
    "vitest.base.ts",
    "eslint.config.mjs",
    ".prettierrc",
    ".npmrc",
    "pnpm-workspace.yaml",
    "scripts/run-bin.mjs"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [],
      "passThroughEnv": ["*"]
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md", "!coverage/**", "!dist/**"]
    },
    "@nomi-ai/renderer#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/scripts/ports.mjs",
        "$TURBO_ROOT$/packages/electron/src/security/csp.ts"
      ]
    },
    "@nomi-ai/ai-chat#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/scripts/ports.mjs",
        "$TURBO_ROOT$/packages/electron/src/security/csp.ts"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md", "!coverage/**", "!dist/**"]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md", "!coverage/**", "!dist/**"]
    },
    "@nomi-ai/electron#package": {
      "cache": false,
      "dependsOn": ["@nomi-ai/electron#build", "@nomi-ai/renderer#build", "@nomi-ai/ai-chat#build"]
    },
    "package:prod:mac": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "package:prod:win": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "package:prod:linux": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "package:debug": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
