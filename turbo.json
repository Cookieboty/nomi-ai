{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.node.json",
    "tsconfig.dom.json",
    "tsup.base.ts",
    "vitest.base.ts",
    "eslint.config.mjs",
    ".prettierrc",
    ".npmrc",
    "pnpm-workspace.yaml",
    "scripts/run-bin.mjs"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [],
      "passThroughEnv": ["*"]
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md", "!coverage/**", "!dist/**"]
    },
    "@nomi-ai/i18n#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-cjs/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "!dist-cjs/**"
      ]
    },
    "@nomi-ai/renderer#build": {
      "dependsOn": ["^build"],
      "env": ["CHARACTER_PACK"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/characters/**",
        "$TURBO_ROOT$/scripts/character/**",
        "$TURBO_ROOT$/scripts/ports.mjs",
        "$TURBO_ROOT$/apps/desktop-electron/src/security/csp.ts",
        "$TURBO_ROOT$/rive/nomi-complete/reference/svg-rig/nomi-fullbody-mother.svg"
      ]
    },
    "@nomi-ai/host-electron#build": {
      "dependsOn": ["^build", "@nomi-ai/renderer#build", "@nomi-ai/ai-chat#build"],
      "env": ["CHARACTER_PACK"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md", "!coverage/**", "!dist/**"]
    },
    "@nomi-ai/ai-chat#build": {
      "dependsOn": ["^build"],
      "env": ["CHARACTER_PACK"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/characters/**",
        "$TURBO_ROOT$/scripts/character/**",
        "$TURBO_ROOT$/scripts/ports.mjs",
        "$TURBO_ROOT$/apps/desktop-electron/src/security/csp.ts"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md", "!coverage/**", "!dist/**"]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md", "!coverage/**", "!dist/**"]
    },
    "@nomi-ai/renderer#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/characters/**",
        "$TURBO_ROOT$/scripts/character/**",
        "$TURBO_ROOT$/scripts/character/pack.mjs",
        "$TURBO_ROOT$/packages/core/src/mascot/mascotSize.ts",
        "$TURBO_ROOT$/rive/nomi-complete/reference/svg-rig/nomi-fullbody-mother.svg"
      ]
    },
    "@nomi-ai/avatar-runtime#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/characters/**"
      ]
    },
    "@nomi-ai/ai-sdk-client#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/packages/ai-runtime/src/channels.ts"
      ]
    },
    "@nomi-ai/host-electron#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/characters/**",
        "$TURBO_ROOT$/assets-licenses.json"
      ]
    },
    "@nomi-ai/core#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/characters/**"
      ]
    },
    "@nomi-ai/host-electron#package": {
      "cache": false,
      "dependsOn": [
        "@nomi-ai/host-electron#build",
        "@nomi-ai/renderer#build",
        "@nomi-ai/ai-chat#build"
      ]
    },
    "package:prod:mac": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "package:prod:win": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "package:prod:linux": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "package:debug": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@nomi-ai/gateway#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "$TURBO_ROOT$/packages/cli-plugins/src/gateways.ts",
        "$TURBO_ROOT$/packages/cli-plugins/src/**",
        "$TURBO_ROOT$/packages/ai-runtime/src/providers/presets.ts"
      ]
    }
  }
}
